DATABASE_URL=postgresql://username:password@localhost:5432/sentinelai
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. If unset, AI analysis endpoints (/ai/...) use a built-in
# deterministic local provider grounded in real app data - no key required,
# nothing breaks. Set this to have those endpoints ask OpenAI to rewrite the
# same grounded data into more natural language (falls back to the local
# result automatically on any API error).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
